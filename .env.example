# This file is for local development examples only. Do not put real secrets here.
BVMAC_PUBLIC_ORIGIN=https://market.example.org
BVMAC_DB_DSN=postgresql://bvmacapi@/bvmac
BVMAC_AUTH_PEPPER=replace-me
BVMAC_LOOKUP_PEPPER=replace-me
BVMAC_WEBSTATS_HMAC_SECRET=replace-me
# Generate a real 32-byte URL-safe key before using encryption in production.
BVMAC_PII_KEY=replace-me
BVMAC_COOKIE_SECURE=0
